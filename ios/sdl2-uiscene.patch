 @end
 
+/* ---- UIScene lifecycle ---- */
+
+UIWindowScene *SDL_uikitWindowScene = nil;
+
+@implementation SDLUIKitSceneDelegate
+
+- (void)scene:(UIScene *)scene willConnectToSession:(UISceneSession *)session options:(UISceneConnectionOptions *)connectionOptions
+{
+    if ([scene isKindOfClass:[UIWindowScene class]]) {
+        SDL_uikitWindowScene = (UIWindowScene *)scene;
+    }
+}
+
+- (void)sceneDidDisconnect:(UIScene *)scene
+{
+    if (scene == SDL_uikitWindowScene) {
+        SDL_uikitWindowScene = nil;
+    }
+}
+
+@end
+
+UIWindowScene *SDL_UIKitWaitForWindowScene(void)
+{
+    /* SDL_main starts right after launching, possibly before the scene has
+     * connected: run the run loop (which delivers that) until it has */
+    for (int i = 0; i < 500 && !SDL_uikitWindowScene; i++) {
+        CFRunLoopRunInMode(kCFRunLoopDefaultMode, 0.01, TRUE);
+    }
+    if (!SDL_uikitWindowScene) {
+        /* (one already connected before this delegate saw it) */
+        for (UIScene *scene in [UIApplication sharedApplication].connectedScenes) {
+            if ([scene isKindOfClass:[UIWindowScene class]]) {
+                SDL_uikitWindowScene = (UIWindowScene *)scene;
+                break;
+            }
+        }
+    }
+    return SDL_uikitWindowScene;
+}
+
 @implementation SDLUIKitDelegate {
     UIWindow *launchWindow;
 }
 
+- (UISceneConfiguration *)application:(UIApplication *)application configurationForConnectingSceneSession:(UISceneSession *)connectingSceneSession options:(UISceneConnectionOptions *)options
+{
+    UISceneConfiguration *config = [[UISceneConfiguration alloc] initWithName:@"SDLSceneConfiguration" sessionRole:connectingSceneSession.role];
+    config.delegateClass = [SDLUIKitSceneDelegate class];
+    return config;
+}
